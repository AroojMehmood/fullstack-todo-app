# MongoDB Atlas connection string (Database > Connect > Drivers se milegi)
MONGODB_URI=your_mongodb_atlas_connection_string_here

# JWT secret — koi bhi lambi random string (min 32 characters recommended)
JWT_SECRET=your_random_jwt_secret_here

# Server port (Render/Railway apna khud set karte hain, local ke liye 5000)
PORT=5000

# Deployed frontend URL (CORS ke liye) — jab tak deploy na ho, localhost rehne do
FRONTEND_URL=http://localhost:5173
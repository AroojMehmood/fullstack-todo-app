{
  "name": "todo-app-backend",
  "version": "1.0.0",
  "description": "Backend for Todo App (Express + in-memory storage)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "mongodb-memory-server": "^11.2.0",
    "cross-env": "^10.1.0"
  },
   "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testTimeout": 30000
  }
}
